# ==========================================
# Xcode Build Artifacts & Internal Files
# ==========================================
DerivedData/
build/
*.xcarchive
*.moved-aside
*.xcuserstate

# ==========================================
# User-Specific Xcode Settings
# ==========================================
# Exclude layout, open tabs, and breakpoint settings unique to your machine
xcuserdata/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ==========================================
# Xcode Server & Source Control Blueprints
# ==========================================
*.xccheckout
*.xcscmblueprint

# ==========================================
# Swift Package Manager (SPM)
# ==========================================
# Exclude the local build cache directory
.build/

# Un-comment the line below if you want to exclude local checkouts of package code
# /Packages
# Package.pins

# ==========================================
# Playgrounds & Workspaces
# ==========================================
*.xctimeline
playground.xcworkspace

# ==========================================
# Dependency Managers (Un-comment if used)
# ==========================================
# CocoaPods 
# Pods/
#
# Carthage
# Carthage/Build/

# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Icon\r
._*
.Spotlight-V100
.fseventsd
